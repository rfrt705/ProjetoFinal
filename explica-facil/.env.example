# O iniciar.py cria automaticamente o .env com valores aleatórios.
# Estes valores são exclusivamente para o desenvolvimento local.
COMPOSE_PROJECT_NAME=SUBSTITUIR
DJANGO_SECRET_KEY=SUBSTITUIR
MYSQL_PASSWORD=SUBSTITUIR
MYSQL_ROOT_PASSWORD=SUBSTITUIR
HOST_PORT=8008
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Europe/Lisbon
# Horários de demonstração. Ajustar aos horários aprovados pelo formador.
SESSION_START_TIMES=09:00,10:00,11:00,14:00,15:00,16:00,17:00
ALLOWED_WEEKDAYS=0,1,2,3,4
